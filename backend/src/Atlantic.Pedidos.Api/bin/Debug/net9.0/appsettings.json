{
  "ConnectionStrings": {
    "miConexion": "Data Source=DESKTOP-0V9BORH\\SQLEXPRESS;Initial Catalog=BDExamenAtlantic;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "Atlantic.Pedidos.Api",
    "Audience": "Atlantic.Pedidos.Web",
    "SigningKey": "",
    "ExpirationMinutes": 60
  },
  "Lockout": {
    "MaxIntentosFallidos": 5,
    "MinutosBloqueo": 15
  },
  "RateLimit": {
    "LoginPorMinuto": 10,
    "ApiPorMinuto": 300
  },
  "Resilience": {
    "Sql": {
      "MaxReintentos": 3,
      "RetrasoBaseMs": 200,
      "TimeoutSegundos": 30,
      "ProporcionFallos": 0.5,
      "MinimoEjecuciones": 5,
      "VentanaSegundos": 60,
      "AperturaSegundos": 20
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Cors": {
    "Origins": [ "https://localhost:5173" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Polly": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Atlantic.Pedidos.Api"
    }
  },
  "AllowedHosts": "*"
}
