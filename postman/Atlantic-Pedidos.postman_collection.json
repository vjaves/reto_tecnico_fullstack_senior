                  "  pm.expect(pm.response.json().code).to.eql('PRODUCTO_CODIGO_DUPLICADO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/productos/{{productoId}}",
