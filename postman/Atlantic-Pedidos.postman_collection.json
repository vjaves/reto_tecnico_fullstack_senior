          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('codigoPrueba', 'PM-' + Date.now().toString().slice(-8));"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 con código normalizado', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const r = pm.response.json();",
                  "  pm.expect(r.codigo).to.eql(pm.collectionVariables.get('codigoPrueba'));",
                  "  pm.collectionVariables.set('productoId', r.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/productos",
            "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"{{codigoPrueba}}\",\n  \"nombre\": \"Cable HDMI 2 m\",\n  \"descripcion\": \"Creado desde Postman\",\n  \"unidadMedidaId\": 1,\n  \"activo\": true\n}" }
